                local function IsSelected(Option)
                    if Dropdown.MultiSelection then
                        return table.find(Dropdown.Value, Option) ~= nil
                    else
                        return Dropdown.Value == Option
                    end
                end

                local function UpdateOptionVisual(Option)
                    local Btn = Dropdown.Buttons[Option]
                    if not Btn then return end
                    local Selected = IsSelected(Option)
                    TweenService:Create(Btn,            TweenInfo.new(.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = Selected and 0 or 0.2}):Play()
                    TweenService:Create(Btn.Title,       TweenInfo.new(.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {TextTransparency       = Selected and 0 or 0.4}):Play()
                    if Btn:FindFirstChild("CheckBox") then
                        local CB = Btn.CheckBox
                        TweenService:Create(CB,        TweenInfo.new(.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundColor3 = Selected and Library.ElementColor or Library.Themes.Default.Divider, BackgroundTransparency = Selected and 0.2 or 0.2}):Play()
                        TweenService:Create(CB.Stroke, TweenInfo.new(.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Color = Selected and Library.ElementColor or Library.Themes.Default.Stroke}):Play()
                        TweenService:Create(CB.Ico,    TweenInfo.new(.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {ImageTransparency = Selected and 0 or 1}):Play()
                    end
                end

                local function RefreshAllVisuals()
                    for Option, _ in pairs(Dropdown.Buttons) do
                        UpdateOptionVisual(Option)
                    end
                end

