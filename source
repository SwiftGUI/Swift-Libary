                    TweenService:Create(Tab.Highlight, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
                end
                if Tab:FindFirstChild("Indicator") then
                    TweenService:Create(Tab.Indicator, TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {BackgroundTransparency = 1, Size = UDim2.new(0,3,0,0)}):Play()
