                                Dropdown:Toggle(Option)
                            else
                                Dropdown:Set(Option)
                            end
                        end)
                        Dropdown.Buttons[Option] = OptionBtn
                    end
                end

                function Dropdown:Refresh(Options, Delete)
                    if Delete then
                        for _,v in pairs(Dropdown.Buttons) do v:Destroy() end
                        table.clear(Dropdown.Options)
                        table.clear(Dropdown.Buttons)
                    end
                    Dropdown.Options = Options
                    AddOptions(Dropdown.Options)
                    RefreshAllVisuals()
                end

                function Dropdown:Toggle(Option)
                    if not Dropdown.MultiSelection then return end
                    if not table.find(Dropdown.Options, Option) then return end
                    local idx = table.find(Dropdown.Value, Option)
                    if idx then
                        table.remove(Dropdown.Value, idx)
                    else
                        table.insert(Dropdown.Value, Option)
                    end
                    UpdateOptionVisual(Option)
                    UpdateSelectedText()
                    DropdownConfig.Callback(Dropdown.Value)
                    if Dropdown.Save and Library.ConfigFile then
                        Library.UserConfig[DropdownConfig.Flag or DropdownConfig.Name] = Dropdown.Value
                        Library:SaveConfig()
                    end
                end

                function Dropdown:Set(Value)
                    if Dropdown.MultiSelection then
                        if type(Value) ~= "table" then Value = {Value} end
                        local ValidValues = {}
                        for _, v in ipairs(Value) do
                            if table.find(Dropdown.Options, v) then table.insert(ValidValues, v) end
                        end
                        Dropdown.Value = ValidValues
                        RefreshAllVisuals()
                        UpdateSelectedText()
                        DropdownConfig.Callback(Dropdown.Value)
                        if Dropdown.Save and Library.ConfigFile then
                            Library.UserConfig[DropdownConfig.Flag or DropdownConfig.Name] = Dropdown.Value
                            Library:SaveConfig()
                        end
                        return
                    end

                    if not table.find(Dropdown.Options, Value) then
                        Dropdown.Value = "..."
                        UpdateSelectedText()
                        RefreshAllVisuals()
                        return
                    end
                    Dropdown.Value = Value
                    UpdateSelectedText()
                    RefreshAllVisuals()
                    DropdownConfig.Callback(Dropdown.Value)
                    if Dropdown.Save and Library.ConfigFile then
                        Library.UserConfig[DropdownConfig.Flag or DropdownConfig.Name] = Value
                        Library:SaveConfig()
                    end
                    return DropdownConfig.Callback(Dropdown.Value)
                end

