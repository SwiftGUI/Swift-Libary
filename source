    local function ApplyChannelEdit(Box, Channel)
        local value = tonumber(Box.Input.Text)
        local current = Color3.fromHSV(ColorH, ColorS, ColorV)
        local r,g,b = math.floor((current.R*255)+0.5), math.floor((current.G*255)+0.5), math.floor((current.B*255)+0.5)
        if value then
            value = math.clamp(math.floor(value), 0, 255)
            if Channel == "R" then r = value
            elseif Channel == "G" then g = value
            else b = value end
            local newColor = Color3.fromRGB(r,g,b)
            ColorH, ColorS, ColorV = newColor:ToHSV()
            ColorSelection.Position = UDim2.new(ColorS, 0, 1-ColorV, 0)
            HueSelection.Position = UDim2.new(0.5, 0, 1-ColorH, 0)
